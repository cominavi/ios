require "shellwords"

default_platform(:ios)

APP_IDENTIFIER = "llc.mikunet.cominavi"
ASC_KEY_ID = "672X4QRBR9"
ASC_ISSUER_ID = "4e3acab8-90e1-48c8-85e6-f8c732797cc5"
PROJECT_PATH = File.expand_path("../ComiNavi.xcodeproj", __dir__)
TESTFLIGHT_SCHEME = "ComiNavi-TestFlight"
TESTFLIGHT_CONFIGURATION = "TestFlight"
TESTFLIGHT_EXPORT_OPTIONS = File.expand_path(
  "../Configuration/FastlaneExportOptions.plist",
  __dir__
)
FASTLANE_BUILD_DIRECTORY = File.expand_path("../build/fastlane", __dir__)
DEFAULT_IPA_PATH = File.join(FASTLANE_BUILD_DIRECTORY, "ComiNavi.ipa")
TESTFLIGHT_EXTERNAL_GROUP = "External Beta"
TESTFLIGHT_NOTES_DIRECTORY = File.expand_path("testflight/what_to_test", __dir__)

def testflight_release_note(locale, override)
  note = override.to_s.strip
  note_path = File.join(TESTFLIGHT_NOTES_DIRECTORY, "#{locale}.txt")
  note = File.read(note_path).strip if note.empty? && File.file?(note_path)

  if note.empty?
    UI.user_error!(
      "Missing #{locale} TestFlight notes. Set the lane option or update #{note_path}"
    )
  end

  note
end

def localized_testflight_build_info(options)
  {
    "ja" => {
      whats_new: testflight_release_note(
        "ja",
        options[:changelog_ja] || ENV["CHANGELOG_JA"]
      )
    },
    "en-US" => {
      whats_new: testflight_release_note(
        "en-US",
        options[:changelog_en] || ENV["CHANGELOG_EN_US"]
      )
    }
  }
end

def external_testflight_group(options)
  group = (options[:group] || ENV["TESTFLIGHT_EXTERNAL_GROUP"] || TESTFLIGHT_EXTERNAL_GROUP).strip
  UI.user_error!("External TestFlight group cannot be empty") if group.empty?
  group
end

def asc_credentials
  key_id = ENV.fetch("ASC_KEY_ID", ASC_KEY_ID).strip
  issuer_id = ENV.fetch("ASC_ISSUER_ID", ASC_ISSUER_ID).strip
  key_filepath = File.expand_path(
    ENV.fetch("ASC_KEY_FILEPATH", File.join(__dir__, "AuthKey_#{key_id}.p8"))
  )

  UI.user_error!("ASC_KEY_ID cannot be empty") if key_id.empty?
  UI.user_error!("ASC_ISSUER_ID cannot be empty") if issuer_id.empty?
  UI.user_error!("App Store Connect key not found at #{key_filepath}") unless File.file?(key_filepath)
  UI.user_error!("App Store Connect key is not readable at #{key_filepath}") unless File.readable?(key_filepath)

  permissions = File.stat(key_filepath).mode & 0o777
  if (permissions & 0o077).positive?
    UI.user_error!(
      "App Store Connect key permissions are too broad (#{format('%03o', permissions)}); run chmod 600 #{key_filepath}"
    )
  end

  {
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_filepath
  }
end

def xcodebuild_authentication_args
  credentials = asc_credentials
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{Shellwords.escape(credentials[:key_filepath])}",
    "-authenticationKeyID #{Shellwords.escape(credentials[:key_id])}",
    "-authenticationKeyIssuerID #{Shellwords.escape(credentials[:issuer_id])}"
  ].join(" ")
end

private_lane :asc_api_key do
  credentials = asc_credentials
  app_store_connect_api_key(
    key_id: credentials[:key_id],
    issuer_id: credentials[:issuer_id],
    key_filepath: credentials[:key_filepath],
    in_house: false
  )
end

private_lane :verify_external_testflight_build do |options|
  asc_api_key
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("App Store Connect app not found for #{APP_IDENTIFIER}") unless app

  build = Spaceship::ConnectAPI::Build.all(
    app_id: app.id,
    version: options.fetch(:app_version),
    build_number: options.fetch(:build_number),
    platform: Spaceship::ConnectAPI::Platform::IOS,
    limit: 1
  ).first
  UI.user_error!("Submitted TestFlight build was not found") unless build

  group = app.get_beta_groups.find { |candidate| candidate.name == options.fetch(:group) }
  UI.user_error!("External TestFlight group was not found") unless group

  assigned_build_ids = group.fetch_builds.map(&:id)
  unless assigned_build_ids.include?(build.id)
    UI.user_error!("Build #{build.version} is not assigned to #{group.name}")
  end

  detail = build.build_beta_detail
  UI.user_error!("Build #{build.version} is missing its TestFlight status") unless detail

  external_state = Spaceship::ConnectAPI::BuildBetaDetail::ExternalState
  expected_states = [
    external_state::WAITING_FOR_BETA_REVIEW,
    external_state::IN_BETA_REVIEW,
    external_state::BETA_APPROVED,
    external_state::IN_BETA_TESTING
  ]
  unless expected_states.include?(detail.external_build_state)
    UI.user_error!(
      "Unexpected external TestFlight state: #{detail.external_build_state}"
    )
  end

  unless detail.auto_notify_enabled
    UI.user_error!("External tester notifications are not enabled")
  end

  UI.success(
    "Verified #{options.fetch(:app_version)} (#{build.version}) in #{group.name}: " \
    "#{detail.external_build_state}"
  )
end

platform :ios do
  desc "Verify App Store Connect API access"
  lane :asc_check do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App Store Connect app not found for #{APP_IDENTIFIER}") unless app
    UI.success("Connected to App Store Connect for #{app.bundle_id}")
  end

  desc "Build a signed TestFlight archive and IPA without uploading it"
  lane :build_testflight do |options|
    authentication_args = xcodebuild_authentication_args
    build_app(
      project: PROJECT_PATH,
      scheme: TESTFLIGHT_SCHEME,
      configuration: TESTFLIGHT_CONFIGURATION,
      clean: true,
      archive_path: File.join(FASTLANE_BUILD_DIRECTORY, "ComiNavi-TestFlight.xcarchive"),
      output_directory: FASTLANE_BUILD_DIRECTORY,
      output_name: File.basename(DEFAULT_IPA_PATH),
      export_options: TESTFLIGHT_EXPORT_OPTIONS,
      skip_build_archive: options[:skip_build_archive] || false,
      xcargs: authentication_args
    )
  end

  desc "Upload an existing signed IPA to TestFlight"
  lane :upload_ipa do |options|
    ipa_path = File.expand_path(options[:ipa] || ENV.fetch("IPA_PATH", DEFAULT_IPA_PATH))
    UI.user_error!("Signed IPA not found at #{ipa_path}") unless File.file?(ipa_path)

    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa_path,
      changelog: options[:changelog] || ENV["CHANGELOG"],
      distribute_external: false,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and upload the current version to TestFlight"
  lane :beta do |options|
    ipa_path = build_testflight
    upload_ipa(ipa: ipa_path, changelog: options[:changelog])
  end

  desc "Upload an existing IPA, submit it to External Beta, and verify the result"
  lane :upload_external_ipa do |options|
    ipa_path = File.expand_path(options[:ipa] || ENV.fetch("IPA_PATH", DEFAULT_IPA_PATH))
    UI.user_error!("Signed IPA not found at #{ipa_path}") unless File.file?(ipa_path)

    app_version = FastlaneCore::IpaFileAnalyser.fetch_app_version(ipa_path)
    build_number = FastlaneCore::IpaFileAnalyser.fetch_app_build(ipa_path)
    group = external_testflight_group(options)

    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa_path,
      app_version: app_version,
      build_number: build_number,
      localized_build_info: localized_testflight_build_info(options),
      distribute_external: true,
      groups: [group],
      notify_external_testers: true,
      skip_waiting_for_build_processing: false
    )

    check_external(
      app_version: app_version,
      build_number: build_number,
      group: group
    )
  end

  desc "Build, upload, submit, and verify an external TestFlight beta"
  lane :external_beta do |options|
    ipa_path = build_testflight
    upload_external_ipa(
      ipa: ipa_path,
      group: options[:group],
      changelog_ja: options[:changelog_ja],
      changelog_en: options[:changelog_en]
    )
  end

  desc "Verify an external TestFlight build without changing App Store Connect"
  lane :check_external do |options|
    app_version = options[:app_version].to_s.strip
    build_number = options[:build_number].to_s.strip
    UI.user_error!("Set app_version, for example app_version:1.0") if app_version.empty?
    UI.user_error!("Set build_number, for example build_number:2026081202") if build_number.empty?

    verify_external_testflight_build(
      app_version: app_version,
      build_number: build_number,
      group: external_testflight_group(options)
    )
  end

  desc "Submit an already-uploaded build to External Beta and verify the result"
  lane :submit_external do |options|
    app_version = options[:app_version].to_s.strip
    build_number = options[:build_number].to_s.strip
    UI.user_error!("Set app_version, for example app_version:1.0") if app_version.empty?
    UI.user_error!("Set build_number, for example build_number:2026081202") if build_number.empty?

    group = external_testflight_group(options)
    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      distribute_only: true,
      app_version: app_version,
      build_number: build_number,
      localized_build_info: localized_testflight_build_info(options),
      distribute_external: true,
      groups: [group],
      notify_external_testers: true,
      skip_waiting_for_build_processing: false
    )

    check_external(
      app_version: app_version,
      build_number: build_number,
      group: group
    )
  end

  desc "Upload App Store metadata and screenshots without uploading or submitting a build"
  lane :upload_metadata do
    review_keys = {
      first_name: "COMINAVI_REVIEW_FIRST_NAME",
      last_name: "COMINAVI_REVIEW_LAST_NAME",
      phone_number: "COMINAVI_REVIEW_PHONE",
      email_address: "COMINAVI_REVIEW_EMAIL",
      demo_user: "COMINAVI_REVIEW_DEMO_USER",
      demo_password: "COMINAVI_REVIEW_DEMO_PASSWORD"
    }

    missing = review_keys.values.reject { |key| ENV.fetch(key, "").strip.length.positive? }
    unless missing.empty?
      UI.user_error!("Set the App Review values outside the repository: #{missing.join(', ')}")
    end

    review_information = review_keys.to_h { |name, key| [name, ENV.fetch(key).strip] }
    review_information[:notes] = File.read(
      File.join(__dir__, "metadata", "review_information", "notes.txt")
    ).strip

    options = {
      app_identifier: APP_IDENTIFIER,
      app_version: "1.0",
      platform: "ios",
      metadata_path: File.join(__dir__, "metadata"),
      screenshots_path: File.join(__dir__, "screenshots"),
      app_rating_config_path: File.join(__dir__, "age_rating.json"),
      app_review_information: review_information,
      skip_binary_upload: true,
      submit_for_review: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: false
    }

    options[:api_key] = asc_api_key

    deliver(**options)
  end
end
