    "%@ will become the owner. You will become an editor." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さんがオーナーになります。あなたは編集者になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님이 소유자가 됩니다. 당신은 편집자가 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将成为所有者，你将成为编辑"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 將成為所有者，你將成為編輯"
          }
        }
      }
    },
    "%@ will immediately lose access. Changes they have not sent will not be shared." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さんはすぐにアクセスできなくなります。送信していない変更は共有されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님은 즉시 액세스 권한을 잃습니다. 아직 전송하지 않은 변경 사항은 공유되지 않습니다。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@将立即失去访问权限。尚未发送的更改不会共享"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@將立即失去存取權限。尚未傳送的更改不會共用"
          }
        }
      }
    },
    "%@ will regain access." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さんは再びアクセスできるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님은 다시 액세스할 수 있습니다。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@将恢复访问权限"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 將恢復存取權"
          }
        }
      }
    },
