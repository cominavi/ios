    "%@ will become the owner. You will become an editor." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さんがオーナーになります。あなたは編集者になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님이 소유자가 됩니다. 당신은 편집자가 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@先生成为所有者。 你成为编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@先生成為所有者。 你成為編輯。"
          }
        }
      }
    },
    "%@ will immediately lose access. Unsynced work remains only on their device." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さんはすぐにアクセスできなくなります。未同期の内容は相手の端末にのみ残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님은 곧 접근할 수 없게 됩니다. 동기화되지 않은 내용은 상대방 기기에만 남습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@先生不能马上访问。 未同步的内容只留在对方的设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@先生馬上就無法訪問了。 未同步的內容只留在對方的裝置上。"
          }
        }
      }
    },
    "%@ will regain access with a new synchronization identity." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さんは新しい同期用IDで再びアクセスできるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님은 새로운 동기화용 ID로 다시 접근할 수 있게 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@先生可以用新的同步用ID再次访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@先生可以用新的同步用ID再次訪問。"
          }
        }
      }
    },
