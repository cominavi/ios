    "Rebase is unavailable for this branch. Export it before discarding if you may need the content." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この履歴はリベースできません。内容が必要な場合は、破棄する前に書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기록은 리베이스할 수 없습니다. 내용이 필요할 경우, 폐기하기 전에 작성해 주시기 바랍니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个履历不能重新基础。 如果需要内容的话，请在销毁之前写出来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個履歷不能重基。 如果需要內容的話，請在銷燬之前寫出來。"
          }
        }
      }
    },
    "Rebase onto the server copy" : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの内容に端末の変更を反映"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 내용에 단말기 변경을 반영합니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在服务器的内容中反映设备的变化"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在伺服器的內容中反映裝置的變化"
          }
        }
      }
    },
    "Rebase replays valid unsynced operations onto a fresh server document. The original remains protected unless the replacement is saved atomically." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リベースでは、有効な未同期の変更を新しいサーバー文書に順番どおり反映します。置き換えが安全に保存されるまで元の履歴は保護されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리베이스에서는 유효한 동기화되지 않은 변경을 새로운 서버 문서에 순서대로 반영합니다. 교체가 안전하게 저장될 때까지 원본 기록은 보호됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在rebase中，有效的未同步变更按顺序反映在新的服务器文档中。 在替换被安全保存之前，原来的履历会受到保护。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在Rebase中，有效的未同步更改會按順序反映到新的伺服器文件中。 在替換被安全儲存之前，原來的記錄會受到保護。"
          }
        }
      }
    },
