        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 작업 내용은 이 기기에서 삭제되며 복구할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存的操作内容会从这个设备中删除，无法恢复。"
