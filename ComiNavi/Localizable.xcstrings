    "Drag to move, pinch to zoom, rotate with two fingers, or tap a venue or table." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグで移動、ピンチで拡大・縮小、2本指で回転できます。会場やスペースをタップして選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그로 이동하고, 핀치로 확대·축소하며, 두 손가락으로 회전할 수 있습니다. 장소나 부스를 탭하여 선택할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用拖动移动，用捏动放大、缩小，用两根手指可以旋转。 可以点击会场或摊位进行选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用拖動移動，用捏動放大、縮小，用兩根手指可以旋轉。 可以點選會場或攤位進行選擇。"
