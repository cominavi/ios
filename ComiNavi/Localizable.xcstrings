          "stringUnit" : {
            "state" : "translated",
            "value" : "無法安全地重新開始已儲存的目錄下載。"
          }
        }
      }
    },
    "The saved intent will be removed from this device and cannot be recovered." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した操作内容はこの端末から削除され、復元できません。"
