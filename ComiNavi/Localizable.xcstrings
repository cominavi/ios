    "Plain text only. Unicode characters are edited by scalar position and saved after a short idle pause or when you leave this screen." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモはプレーンテキストです。Unicode文字を正しい位置で扱い、入力が少し止まったとき、またはこの画面を離れるときにまとめて保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모는 플레인 텍스트입니다. Unicode 문자를 올바른 위치에서 다루고, 입력이 잠시 멈췄을 때 또는 이 화면을 떠날 때 한 번에 저장합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备忘录是纯文本。 在正确的位置处理Unicode文字，在输入稍微停止时，或者离开这个画面时一起保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備忘錄是純文字。 將Unicode文字處理在正確的位置，在輸入稍微停止時，或者離開這個畫面時一起儲存。"
          }
        }
      }
    },
