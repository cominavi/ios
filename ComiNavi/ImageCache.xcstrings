    "Image caches keep downloaded images available without downloading them again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Image caches keep downloaded images available without downloading them again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像キャッシュに保存すると、ダウンロードし直さずに画像を表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지 캐시에 저장하면 다시 다운로드하지 않고 이미지를 볼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图片缓存会保留已下载的图片，之后无需再次下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖片快取會保留已下載的圖片，之後無需再次下載。"
          }
        }
