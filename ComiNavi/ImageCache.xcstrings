    "Downloaded images will be removed and downloaded again when needed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloaded images will be removed and downloaded again when needed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みの画像は削除され、必要になったときに再ダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 이미지가 삭제되며 필요할 때 다시 다운로드됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已下载的图片将被删除，并会在需要时重新下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已下載的圖片將被刪除，並會在需要時重新下載。"
          }
        }
      }
    },
